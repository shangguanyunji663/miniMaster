# miniMaster 配置模板 —— 复制为 .env 并填入真实值
# 真实凭据只允许存在于 .env（已被 .gitignore 忽略），运行时经环境变量注入。

# ---- LLM（OpenAI 兼容端点，需支持 function calling）----
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=your-model-name
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
# 单次请求超时（秒）
LLM_TIMEOUT=180

# ---- 按角色模型路由（留空 = 回落主模型与主温度）----
# Validator 建议低温（验收要确定性）；Planner 可用更强/更便宜的模型
LLM_PLANNER_MODEL=
LLM_VALIDATOR_MODEL=
LLM_PLANNER_TEMPERATURE=0.2
LLM_VALIDATOR_TEMPERATURE=0.0
# 流式输出（1 开启；端点不支持时自动回落非流式）
LLM_STREAM=1

# ---- Harness 预算 ----
# Planner-Executor-Validator 外层最大轮数
AGENT_MAX_ROUNDS=3
# Executor 单任务最大步数
AGENT_MAX_STEPS=15
# 单任务最大重试次数
AGENT_MAX_RETRIES=2
# 独立任务并行度（1 = 顺序执行）
AGENT_PARALLEL=1
# 全局 token 预算熔断（prompt+completion 总量；0 = 不限制）
AGENT_MAX_TOTAL_TOKENS=800000

# ---- MCP 外部工具（可选）----
# 任一 MCP stdio server 启动命令（空 = 不启用），工具以 mcp_<名> 注册
# 示例：MCP_SERVER_CMD=uvx mcp-server-fetch
MCP_SERVER_CMD=
MCP_SERVER_TIMEOUT=30

# ---- Guard ----
# 同一动作连续出现 N 次即拦截
GUARD_MAX_REPEAT=2
# 振荡检测：最近 N 步内同一动作（含相同参数）累计 M 次即拦截
GUARD_WINDOW_SIZE=12
GUARD_WINDOW_MAX=4

# ---- 记忆裁剪 ----
# 单条观察截断阈值（字符）
MEMORY_RESULT_MAX_CHARS=6000
# 视图总字符超阈值触发 LLM 语义压缩
MEMORY_VIEW_THRESHOLD=24000
# 保留最近 N 步全文
MEMORY_RECENT_STEPS=6
# Executor live 消息流字符阈值（超限即压缩）
MEMORY_LIVE_THRESHOLD=30000
# 真实 prompt token 预算（上次响应 usage 超限立即触发 live 压缩）
MEMORY_TOKEN_BUDGET=24000
